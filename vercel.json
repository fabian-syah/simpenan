{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/files/thumbnail", "destination": "/api/files/download?thumb=true" },
    { "source": "/api/files/variants", "destination": "/api/files/list?variants_only=true" },
    { "source": "/api/files/get", "destination": "/api/files/list" },
    { "source": "/api/storage/quota", "destination": "/api/storage?action=quota" },
    { "source": "/api/storage/providers", "destination": "/api/storage?action=providers" },
    { "source": "/api/auth/login", "destination": "/api/storage?action=login" },
    { "source": "/api/auth/register", "destination": "/api/storage?action=register" },
    { "source": "/api/auth/session", "destination": "/api/storage?action=session" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
      ]
    },
    {
      "source": "/ffmpeg/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    }
  ]
}
