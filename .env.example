# ===========================================
# CloudVault — Environment Variables
# ===========================================
# Copy this file to .env and fill in your credentials.
# The app runs in demo mode when credentials are absent.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backblaze B2 (S3-compatible)
BB_KEY_ID=your-backblaze-key-id
BB_APP_KEY=your-backblaze-app-key
BB_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BB_BUCKET=drive-clone-bb
BB_REGION=us-west-004

# Filebase (S3-compatible)
FB_KEY=your-filebase-access-key
FB_SECRET=your-filebase-secret-key
FB_ENDPOINT=https://s3.filebase.com
FB_BUCKET=drive-clone-fb
